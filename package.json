{
  "name": "desk-racer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap sync android && npx cap run android"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.183.2",
    "vite": "^6.2.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/android": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "typescript": "~5.8.2",
    "@capacitor/cli": "^8.6.0"
  }
}
